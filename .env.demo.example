# Demo overrides — shrink the rate window so an "hourly" rollover is visible in ~1 minute.
# Usage (values here override .env, because real env vars win over the .env file):
#   set -a; source .env.demo.example; set +a; npm run dev
RATE_WINDOW_SECONDS=60
MAX_EMAILS_PER_HOUR_PER_SENDER=4
MAX_EMAILS_PER_HOUR=100
MIN_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# Warm-up "day" of 2 minutes so the ramp is visible on camera; pause a sender after 3 failures.
WARMUP_DAY_SECONDS=120
SENDER_PAUSE_AFTER_FAILURES=3
SENDER_PAUSE_MINUTES=2
