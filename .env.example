# ─────────────────────────────────────────────────────────────
# ReachInbox scheduler — copy to .env and fill the blanks.
# Every tunable lives here; nothing is hardcoded in the code.
# ─────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
LOG_LEVEL=info
# Random ≥32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 bytes base64 (AES-256-GCM for Slack tokens / SMTP passwords):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Infra (docker-compose maps to these host ports) ──
DATABASE_URL=postgresql://ri:ri@localhost:5434/reachinbox
REDIS_URL=redis://localhost:6380
ELASTICSEARCH_URL=http://localhost:9200

# ── Google OAuth (console.cloud.google.com → Credentials → OAuth client ID → Web) ──
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth (api.slack.com/apps → scopes: incoming-webhook, chat:write) ──
# Slack requires HTTPS: expose the API with `cloudflared tunnel --url http://localhost:4000`
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# ── Sender health ──
# One warm-up "day" in seconds (86400). Senders with warm-up on get a daily cap that ramps up.
WARMUP_DAY_SECONDS=86400
# Circuit breaker: pause a sender after N failed sends in a row, for M minutes.
SENDER_PAUSE_AFTER_FAILURES=5
SENDER_PAUSE_MINUTES=30

# ── Connecting email accounts ──
# Connecting an account takes a user-supplied SMTP host. Hosts that resolve to a loopback / private
# address are refused (so the form can't probe the internal network). Set true only for local SMTP test servers.
ALLOW_PRIVATE_SMTP_HOSTS=false

# ── Operators ──
# Comma-separated emails allowed to open Bull Board (/admin/queues). Empty = any signed-in user.
ADMIN_EMAILS=

# ── Scheduler / throttling ──
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender (ms)
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global cap across all senders, per window
MAX_EMAILS_PER_HOUR=200
# Cap per sender, per window
MAX_EMAILS_PER_HOUR_PER_SENDER=50
# Window length in seconds (3600 = hourly; shrink for demos, e.g. 120)
RATE_WINDOW_SECONDS=3600
EMAIL_MAX_ATTEMPTS=3
# A row stuck in SENDING longer than this is marked FAILED on boot (never re-sent)
STALE_SENDING_MS=300000
